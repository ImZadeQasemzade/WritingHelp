<resources>

    <!-- Normal app theme, used by the launcher Settings screen. -->
    <style name="Theme.WritingHelp" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Theme for the ACTION_PROCESS_TEXT activities. The window itself is fully transparent;
      Compose draws its own scrim + centered card, so the activity looks like a small floating
      popup rather than a full-screen page - this matches how the OS's own text-processing
      pickers (e.g. Translate, Dictionary) present themselves.
    -->
    <style name="Theme.WritingHelp.Popup" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- One row of the bubble's action menu: full-width, left-aligned text button. -->
    <style name="BubbleMenuItem" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#0C447C</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>

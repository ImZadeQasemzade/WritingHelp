<?xml version="1.0" encoding="utf-8"?>
<!--
  Single overlay view added to the WindowManager by BubbleService.
  Collapsed = only @id/bubble is visible. Tapping it reveals @id/panel, which shows one of:
  @id/menu (pick an action), @id/write_box (type a "Write for me" request) or
  @id/strip (working / result actions).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bubble_panel_bg"
        android:elevation="8dp"
        android:padding="6dp"
        android:layout_marginEnd="8dp">

        <LinearLayout
            android:id="@+id/menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_fix"
                style="@style/BubbleMenuItem"
                android:text="@string/bubble_menu_fix" />

            <Button
                android:id="@+id/btn_rewrite"
                style="@style/BubbleMenuItem"
                android:text="@string/bubble_menu_rewrite" />

            <Button
                android:id="@+id/btn_translate"
                style="@style/BubbleMenuItem"
                android:text="@string/bubble_menu_translate" />

            <Button
                android:id="@+id/btn_write"
                style="@style/BubbleMenuItem"
                android:text="@string/bubble_menu_write" />

            <TextView
                android:id="@+id/menu_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:padding="10dp"
                android:text="@string/bubble_menu_all_off"
                android:textColor="#444444"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/write_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/write_input"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:hint="@string/bubble_write_hint"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:maxLines="4"
                android:minLines="2"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:textColor="#222222"
                android:textColorHint="#888888"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_write_cancel"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bubble_cancel"
                    android:textColor="#666666" />

                <Button
                    android:id="@+id/btn_write_go"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bubble_write_go"
                    android:textColor="#185FA5"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/strip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#333333"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:id="@+id/strip_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/strip_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_redo"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bubble_redo"
                        android:textColor="#185FA5" />

                    <Button
                        android:id="@+id/btn_undo"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bubble_undo"
                        android:textColor="#185FA5" />

                    <Button
                        android:id="@+id/btn_explain"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bubble_explain"
                        android:textColor="#0C447C"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_circle_bg"
        android:outlineProvider="none">

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bubble"
            android:contentDescription="@string/bubble_switch_label" />
    </FrameLayout>
</LinearLayout>
